{
    "version": 4,
    "configurations": [
        {
            "name": "macOS Apple Silicon",
            "compilerPath": "/usr/bin/clang++",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "GL_SILENCE_DEPRECATION"
            ],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ]
}