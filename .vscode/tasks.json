{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Active OpenGL File",
            "type": "process",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-framework",
                "OpenGL",
                "-framework",
                "GLUT"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the active OpenGL source file using Apple Clang"
        },
        {
            "label": "Build and Run Active OpenGL File",
            "type": "process",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "Build Active OpenGL File",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": []
        }
    ]
}